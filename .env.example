# CodeMate Configuration

# Model Provider: 'ollama' (recommended local), 'demo' (offline rule scanner), or 'api' (OpenAI-compatible)
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5-coder:1.5b

# Ollama local endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Remote API settings
API_KEY=
API_BASE_URL=https://api.openai.com/v1

# Limits & Server
MAX_CODE_LENGTH=12000
MODEL_TIMEOUT=120
SECRET_KEY=codemate-development-key

